      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Update Current &amp; Historic Date"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{07DF1F6F-92DF-47E8-A4F5-A24FF60F5CF7}"
          SQLTask:SqlStatementSource="update [Master].[Date]&#xA;  set LoadFlagName = 'Current'&#xA;  where datealternateid = convert(date,dateadd(d,-1, getdate()));&#xA;&#xA;&#xA;update [Master].[Date]&#xA;  set LoadFlagName = 'Historic'&#xA;  where DateID &gt;= ? &#xA;  and datealternateid &lt;= convert(date,dateadd(d,-2, getdate()));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::DateIDFrom"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
