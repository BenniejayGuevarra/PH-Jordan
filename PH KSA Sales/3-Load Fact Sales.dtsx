          SQLTask:SqlStatementSource="insert into [Fact].[SalesDailyDetailed]&#xA;&#x9;select next value for [Fact].[SalesDailyDetIDs] as SalesDailyDetID&#xA;      ,[StoreID]&#xA;      ,[SalesDate]&#xA;      ,[DateID]&#xA;      ,SalesHour [HourID]&#xA;      ,[CheckID]&#xA;      ,[PaymentTypeID] &#xA;      ,[PromoTypeID]&#xA;      ,[CompTypeID]&#xA;      ,[PaidAmount]&#xA;      ,[PromoAmount]&#xA;      ,[CompAmount]&#xA;      ,0 [PaidAmountLY]&#xA;      ,0 [PromoAmountLY]&#xA;      ,0 [CompAmountLY]&#xA;      ,0 [PaidAmountFLY]&#xA;      ,0 [PromoAmountFLY]&#xA;      ,0 [CompAmountFLY]&#xA;&#x9;  ,'arlene.bogal@intellytics.com' CreatedBy&#xA;&#x9;  ,getdate() CreatedOn&#xA;&#x9;  ,'arlene.bogal@intellytics.com' LastUpdatedBy&#xA;&#x9;  ,getdate() LastUpdatedOn&#xA;&#x9;  ,18 CompanyID&#xA;&#x9;  ,'D' SalesFlag&#xA;&#xA;  FROM [Sales].[StageDailyODS]&#xA;  where dateid &gt;= ?&#xA;  and dateid &lt;= ?&#xA;  and detailtype = 2" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
