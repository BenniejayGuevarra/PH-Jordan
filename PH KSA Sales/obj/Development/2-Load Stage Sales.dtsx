teID &lt;= ?&#xA;  AND ft.PaymentType IS NOT NULL&#xA;  AND pt.[Name] IS NULL&#xA;  AND ft.BrandID = ?&#xA;GROUP BY ft.[PaymentTypeID], ft.[PaymentType];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
