          DTS:Description="Execute SQL Task"
          DTS:DTSID="{36742059-F0A4-4B3F-A9AB-E6BF8B78480F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Update Master CompType"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{07DF1F6F-92DF-47E8-A4F5-A24FF60F5CF7}"
              SQLTask:SqlStatementSource="INSERT INTO [Master].[CompType]&#xA;    (CompTypeID, CompTypeCode, [Name], ShortName, [Description],&#xA;     AlternateName1, AlternateName2, SortKey, CreatedBy, CreatedOn,&#xA;     LastUpdatedBy, LastUpdatedOn, CompanyID, RecordStatusID, RecordActive,&#xA;     ParentCode, BrandID)&#xA;SELECT&#xA;        NEXT VALUE FOR [Master].[CompTypeIDs]  AS CompTypeID,&#xA;        ft.[CompTypeID]                          CompTypeCode,&#xA;        ft.[CompName]                            [Name],&#xA;        NULL                                     ShortName,&#xA;        NULL                                      [Description],&#xA;        NULL                                      AlternateName1,&#xA;        NULL                                       AlternateName2,&#xA;        99                                         SortKey,&#xA;        'ETL Package'                             CreatedBy,&#xA;        getdate()                                  CreatedOn,&#xA;        'ETL Package'                             LastUpdatedBy,&#xA;        getdate()                                  LastUpdatedOn,&#xA;        45                                          CompanyID,&#xA;        1                                           RecordStatusID,&#xA;        1                                           RecordActive,&#xA;        3                                           ParentCode,&#xA;        101                                         BrandID&#xA;FROM [Sales].[StageDaily] ft&#xA;LEFT JOIN (&#xA;    SELECT CompTypeCode, [Name]&#xA;    FROM [Master].[CompType]&#xA;    WHERE BrandID = ?&#xA;) ct ON ft.CompTypeID = ct.CompTypeCode&#xA;WHERE DateID &gt;= ?&#xA;  AND DateID &lt;= ?&#xA;  AND ft.CompName IS NOT NULL&#xA;  AND ct.[Name] IS NULL&#xA;  AND ft.BrandID = ?&#xA;GROUP BY ft.[CompTypeID], ft.[CompName];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::BrandID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::DateFrom"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="User::DateTo"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="3"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="3"
                SQLTask:DtsVariableName="User::BrandID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
