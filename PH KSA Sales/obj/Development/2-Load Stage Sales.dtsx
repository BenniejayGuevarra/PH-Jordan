              SQLTask:SqlStatementSource="INSERT INTO [Master].[OrderType]&#xA;    (OrderTypeID, OrderTypeCode, [Name], [Description], ShortName,&#xA;     ParentName, ParentShortName, OnOffPremise, AlternateName1, AlternateName2,&#xA;     SortKey, CreatedBy, CreatedOn, LastUpdatedBy, LastUpdatedOn,&#xA;     CompanyID, RecordStatusID, RecordActive, BrandID)&#xA;SELECT&#xA;        NEXT VALUE FOR [Master].[OrderTypeIDs]        AS OrderTypeID,&#xA;        ft.[OrderTypeID]                                 OrderTypeCode,&#xA;        ft.[OrderType]                                   [Name],&#xA;        NULL                                              [Description],&#xA;        LEFT(UPPER(TRIM(ft.[OrderType])), 3)             ShortName,&#xA;        NULL                                              ParentName,&#xA;        NULL                                               ParentShortName,&#xA;        'On Premise'                                       OnOffPremise,&#xA;        NULL                                                AlternateName1,&#xA;        NULL                                                 AlternateName2,&#xA;        99                                                   SortKey,&#xA;        'ETL Package'                                       CreatedBy,&#xA;        getdate()                                             CreatedOn,&#xA;        'ETL Package'                                       LastUpdatedBy,&#xA;        getdate()                                             LastUpdatedOn,&#xA;        45                                                    CompanyID,&#xA;        1                                                     RecordStatusID,&#xA;        1                                                     RecordActive,&#xA;        101                                                   BrandID&#xA;FROM [Sales].[StageDaily] ft&#xA;LEFT JOIN (&#xA;    SELECT OrderTypeCode, [Name]&#xA;    FROM [Master].[OrderType]&#xA;    WHERE BrandID = ?&#xA;) ot ON ft.OrderTypeID = ot.OrderTypeCode&#xA;WHERE DateID &gt;= ?&#xA;  AND DateID &lt;= ?&#xA;  AND ft.OrderType IS NOT NULL&#xA;  AND ot.[Name] IS NULL&#xA;  AND ft.BrandID = ?&#xA;GROUP BY ft.[OrderTypeID], ft.[OrderType];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
