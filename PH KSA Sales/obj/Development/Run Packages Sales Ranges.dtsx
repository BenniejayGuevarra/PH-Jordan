    <DTS:Executable
      DTS:refId="Package\SQL Date Iteration"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0DC1F4FB-6CEC-4166-BF32-409724EAD32C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Date Iteration"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0"
        DTS:LoggingMode="2" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{07DF1F6F-92DF-47E8-A4F5-A24FF60F5CF7}"
          SQLTask:SqlStatementSource="DECLARE @DateList TABLE (DateID INT);&#xA;&#xA;INSERT INTO @DateList (DateID)&#xA;VALUES (20240227),(20240228),(20240229),(20240301),(20240302),(20240303),(20240304),(20240306),&#xA;       (20240317),(20240318),(20240319),(20240320),(20240321),(20240322),(20240324),(20240325),&#xA;       (20240326),(20240327),(20240328),(20240331),(20240415),(20240416),(20240417),(20240418),&#xA;       (20240419),(20240420),(20240421),(20240422),(20240523),(20240524),(20240525),(20240526),&#xA;       (20240527),(20240528),(20240529),(20240530),(20240531),(20240601),(20240603),(20240623),&#xA;       (20240624),(20240625),(20240626),(20240627),(20240628),(20240629),(20240630),(20240701),&#xA;       (20240714),(20240715),(20240716),(20240717),(20240718),(20240719),(20240720),(20240721),&#xA;       (20240722),(20240808),(20240811),(20240812),(20240813),(20240814),(20240815),(20240816),&#xA;       (20240817),(20240908),(20240909),(20240910),(20240911),(20240912),(20240913),(20240914),&#xA;       (20240915),(20240916),(20251201),(20251208),(20260129),(20260209),(20260307),(20260308),&#xA;       (20260326);&#xA;&#xA;;WITH ExpandedList AS (&#xA;    -- the original dates being rerun&#xA;    SELECT DateID FROM @DateList&#xA;&#xA;    UNION  -- dedupes automatically, no need for DISTINCT&#xA;&#xA;    -- any CY date whose FISCAL LY lookup (@CalendarType='Fiscal') points back to one of our dates&#xA;    SELECT d.DateID&#xA;    FROM RAHDWPHMena.Master.Date d&#xA;    JOIN @DateList dl ON d.DateLYSecAlternateID = CONVERT(DATE, CONVERT(CHAR(8), dl.DateID))&#xA;&#xA;    UNION&#xA;&#xA;    -- any CY date whose CALENDAR LY lookup (@CalendarType='Calendar') points back to one of our dates&#xA;    SELECT d.DateID&#xA;    FROM RAHDWPHMena.Master.Date d&#xA;    JOIN @DateList dl ON d.DayLYSecAlternateID = CONVERT(DATE, CONVERT(CHAR(8), dl.DateID))&#xA;),&#xA;Islands AS (&#xA;    SELECT&#xA;        DateID,&#xA;        CAST(CONVERT(CHAR(8), DateID) AS DATE) AS DateValue,&#xA;        DATEADD(DAY, -ROW_NUMBER() OVER (ORDER BY CAST(CONVERT(CHAR(8), DateID) AS DATE)),&#xA;                 CAST(CONVERT(CHAR(8), DateID) AS DATE)) AS GrpKey&#xA;    FROM ExpandedList&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, FORMAT(MIN(DateValue), 'yyyyMMdd')) AS StartDate,&#xA;    CONVERT(INT, FORMAT(MAX(DateValue), 'yyyyMMdd')) AS EndDate&#xA;FROM Islands&#xA;GROUP BY GrpKey&#xA;ORDER BY StartDate;"
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::objDateRange" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Date Ranged Iteration combined"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{0154157b-e9f0-482a-a4df-ff3613564a32}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Date Ranged Iteration combined"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:LoggingOptions
        DTS:FilterKind="0"
        DTS:LoggingMode="2" />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{07DF1F6F-92DF-47E8-A4F5-A24FF60F5CF7}"
          SQLTask:SqlStatementSource="DECLARE @DateList TABLE (DateID INT);&#xA;&#xA;INSERT INTO @DateList (DateID)&#xA;VALUES (20240227),(20240228),(20240229),(20240301),(20240302),(20240303),(20240304),(20240306),&#xA;       (20240317),(20240318),(20240319),(20240320),(20240321),(20240322),(20240324),(20240325),&#xA;       (20240326),(20240327),(20240328),(20240331),(20240415),(20240416),(20240417),(20240418),&#xA;       (20240419),(20240420),(20240421),(20240422),(20240523),(20240524),(20240525),(20240526),&#xA;       (20240527),(20240528),(20240529),(20240530),(20240531),(20240601),(20240603),(20240623),&#xA;       (20240624),(20240625),(20240626),(20240627),(20240628),(20240629),(20240630),(20240701),&#xA;       (20240714),(20240715),(20240716),(20240717),(20240718),(20240719),(20240720),(20240721),&#xA;       (20240722),(20240808),(20240811),(20240812),(20240813),(20240814),(20240815),(20240816),&#xA;       (20240817),(20240908),(20240909),(20240910),(20240911),(20240912),(20240913),(20240914),&#xA;       (20240915),(20240916),(20251201),(20251208),(20260129),(20260209),(20260307),(20260308),&#xA;       (20260326);&#xA;&#xA;DECLARE @Interval INT = 15;&#xA;&#xA;;WITH ExpandedList AS (&#xA;    -- original dates being rerun&#xA;    SELECT DateID FROM @DateList&#xA;&#xA;    UNION  -- dedupes automatically&#xA;&#xA;    -- CY dates whose FISCAL LY lookup points back to one of our dates&#xA;    SELECT d.DateID&#xA;    FROM RAHDWPHMena.Master.Date d&#xA;    JOIN @DateList dl ON d.DateLYSecAlternateID = CONVERT(DATE, CONVERT(CHAR(8), dl.DateID))&#xA;&#xA;    UNION&#xA;&#xA;    -- CY dates whose CALENDAR LY lookup points back to one of our dates&#xA;    SELECT d.DateID&#xA;    FROM RAHDWPHMena.Master.Date d&#xA;    JOIN @DateList dl ON d.DayLYSecAlternateID = CONVERT(DATE, CONVERT(CHAR(8), dl.DateID))&#xA;),&#xA;Islands AS (&#xA;    SELECT&#xA;        DateID,&#xA;        CAST(CONVERT(CHAR(8), DateID) AS DATE) AS DateValue,&#xA;        DATEADD(DAY, -ROW_NUMBER() OVER (ORDER BY CAST(CONVERT(CHAR(8), DateID) AS DATE)),&#xA;                 CAST(CONVERT(CHAR(8), DateID) AS DATE)) AS GrpKey&#xA;    FROM ExpandedList&#xA;),&#xA;Ranges AS (&#xA;    SELECT MIN(DateValue) AS IslandStart, MAX(DateValue) AS IslandEnd&#xA;    FROM Islands&#xA;    GROUP BY GrpKey&#xA;),&#xA;Chunks AS (&#xA;    -- anchor: one row per island, chunk starts at the island's own start&#xA;    SELECT IslandStart, IslandEnd, IslandStart AS ChunkStart&#xA;    FROM Ranges&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- recursive: step @Interval days forward WITHIN the same island until its own end&#xA;    SELECT IslandStart, IslandEnd, DATEADD(DAY, @Interval, ChunkStart)&#xA;    FROM Chunks&#xA;    WHERE DATEADD(DAY, @Interval - 1, ChunkStart) &lt; IslandEnd&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, FORMAT(ChunkStart, 'yyyyMMdd')) AS StartDate,&#xA;    CONVERT(INT, FORMAT(&#xA;        CASE&#xA;            WHEN DATEADD(DAY, @Interval - 1, ChunkStart) &gt; IslandEnd THEN IslandEnd&#xA;            ELSE DATEADD(DAY, @Interval - 1, ChunkStart)&#xA;        END, 'yyyyMMdd')) AS EndDate&#xA;FROM Chunks&#xA;ORDER BY StartDate&#xA;OPTION (MAXRECURSION 1000);"
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::objDateRange" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
