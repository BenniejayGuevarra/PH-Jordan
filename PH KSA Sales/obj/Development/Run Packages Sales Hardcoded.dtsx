          SQLTask:Connection="{07DF1F6F-92DF-47E8-A4F5-A24FF60F5CF7}"
          SQLTask:SqlStatementSource="DECLARE @StartDate INT = ?;&#xA;DECLARE @EndDate   INT = ?;&#xA;DECLARE @Interval  INT = 20;&#xA;&#xA;WITH Ranges AS (&#xA;    SELECT CAST(CONVERT(CHAR(8), @StartDate) AS DATE) AS StartDate&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, @Interval, StartDate)&#xA;    FROM Ranges&#xA;    WHERE DATEADD(DAY, @Interval - 1, StartDate) &lt; CAST(CONVERT(CHAR(8), @EndDate) AS DATE)&#xA;)&#xA;SELECT &#xA;    CONVERT(INT, FORMAT(StartDate, 'yyyyMMdd')) AS StartDate,&#xA;    CONVERT(INT, FORMAT(&#xA;        CASE &#xA;            WHEN DATEADD(DAY, @Interval - 1, StartDate) &gt; CAST(CONVERT(CHAR(8), @EndDate) AS DATE)&#xA;                THEN CAST(CONVERT(CHAR(8), @EndDate) AS DATE)&#xA;            ELSE DATEADD(DAY, @Interval - 1, StartDate)&#xA;        END, 'yyyyMMdd')) AS EndDate&#xA;FROM Ranges&#xA;OPTION (MAXRECURSION 1000);"
          SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
