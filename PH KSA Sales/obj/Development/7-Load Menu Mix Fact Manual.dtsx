              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">EXEC [MenuMix].[usp_GetCY_LY_FLY_MenuMixDataPH] @StartDate = ?, @EndDate = ?
WITH RESULT SETS
(
    (
        CompanyID                      int,
        BrandID                        int,
        StoreID                        int,
        OrderTypeID                    int,
        ProductFlatID                  int,
        CategoryCombinationID          int,
        SegmentID                      tinyint,
        PromoTypeID                    int,
        CompTypeID                     int,
        DiscountTypeID                 int,
        HourID                         smallint,
        DateID                         int,
        BusinessDate                   date,
        SalesDate                      date,
        TransactionID                  nvarchar(100),
        PaidModifierCount              tinyint,
        PaidBogo                       nvarchar(1),
        TransactionIDCLY               nvarchar(100),
        PaidModifierCountCLY           tinyint,
        PaidBogoCLY                    nvarchar(1),
        TransactionIDFLY               nvarchar(100),
        PaidModifierCountFLY           tinyint,
        PaidBogoFLY                    nvarchar(1),
        PaidModifier                   nvarchar(1),
